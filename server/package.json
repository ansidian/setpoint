{
  "name": "@setpoint/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.ts",
    "dev": "SETPOINT_CLOCK=${SETPOINT_CLOCK:-seed} node --watch src/server.ts",
    "cli": "node src/cli.ts",
    "seed": "node src/seed.ts",
    "try": "node src/try.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc -p tsconfig.json --incremental --tsBuildInfoFile ../node_modules/.cache/tsc/server.tsbuildinfo"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@setpoint/shared": "*",
    "@simplewebauthn/server": "13.3.3",
    "bcryptjs": "3.0.3",
    "better-sqlite3": "13.0.3",
    "chrono-node": "2.10.1",
    "dom-serializer": "2.0.0",
    "domhandler": "5.0.3",
    "domutils": "3.2.2",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.13",
    "htmlparser2": "10.1.0",
    "imapflow": "1.7.8",
    "mailparser": "3.14.1",
    "sharp": "0.35.5",
    "tldts": "7.4.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "drizzle-kit": "0.31.11"
  }
}
