        "items_kind": {
          "name": "items_kind",
          "value": "\"items\".\"kind\" in ('event', 'task')"
        },
        "items_when": {
          "name": "items_when",
          "value": "case \"items\".\"kind\"\n    when 'task' then \"items\".\"due_date\" is not null and \"items\".\"starts_at\" is null and \"items\".\"start_date\" is null\n    else (\"items\".\"all_day\" and \"items\".\"start_date\" is not null and \"items\".\"end_date\" is not null)\n      or (not \"items\".\"all_day\" and \"items\".\"starts_at\" is not null and \"items\".\"ends_at\" is not null) end"
        }
      }
