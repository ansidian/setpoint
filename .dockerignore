# Only what the image builds from; never databases, keys, exports or env files. It applies to a
# folder context: OPERATIONS.md's `git archive HEAD | docker build -` sends a tarball, which Docker
# takes whole (committed files only), so there the web stage has web/tests (SV-188).
**
!package.json
!package-lock.json
!tsconfig.base.json
!shared/
!shared/**
!server/package.json
!server/src/
!server/src/**
!server/drizzle/
!server/drizzle/**
!web/
!web/**
!extension/src/words.ts
**/node_modules
**/dist
**/.env*
**/*.sqlite*
**/*.key
**/*.pem
**/*export*.json
web/tests
