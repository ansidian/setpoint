{
  "name": "setpoint",
  "version": "2.0.0-dev",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "start": "npm run start -w server",
    "dev": "npm run dev -w server",
    "cli": "npm run cli -w server --",
    "build": "npm run build -w web",
    "seed": "npm run seed -w server --",
    "try": "npm run try -w server --",
    "db:generate": "npm run db:generate -w server --",
    "glyphs": "npm run glyphs -w web",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node web/tests/unit.ts",
    "test:browser": "node web/tests/browser/run.ts",
    "test:browser:stress": "SETPOINT_BROWSER_STRESS=1 node web/tests/browser/run.ts",
    "test:pages": "SETPOINT_PAGES=1 node web/tests/browser/run.ts",
    "goldens": "SETPOINT_PAGES=1 SETPOINT_UPDATE_GOLDENS=1 node web/tests/browser/run.ts",
    "contract:record": "SETPOINT_UPDATE_CONTRACT=1 vitest run --project server contract.test",
    "compose:record": "SETPOINT_UPDATE_COMPOSE=1 vitest run --project web composeBundle",
    "audit:boards": "node web/tests/browser/audit.ts",
    "release:check": "node web/tests/release.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "vite": "8.3.5",
    "tldts-core": "7.4.15",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.2"
    }
  }
}
