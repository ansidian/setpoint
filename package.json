{
  "name": "setpoint",
  "version": "2.0.0-dev",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "start": "npm run start -w server",
    "dev": "npm run dev -w server",
    "cli": "npm run cli -w server --",
    "build": "npm run build -w web",
    "seed": "npm run seed -w server --",
    "try": "npm run try -w server --",
    "db:generate": "npm run db:generate -w server --",
    "glyphs": "npm run glyphs -w web",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p extension/tsconfig.json --incremental --tsBuildInfoFile node_modules/.cache/tsc/extension.tsbuildinfo",
    "extension:build": "node extension/build.ts",
    "test": "node web/tests/unit.ts",
    "test:watch": "vitest --project server --project web",
    "test:browser": "node web/tests/browser/run.ts",
    "release:check": "node web/tests/release.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/chrome": "0.3.7",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  },
  "overrides": {
    "vite": "8.3.8",
    "tldts-core": "7.5.5",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.2"
    }
  },
  "allowScripts": {
    "better-sqlite3@13.2.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}
