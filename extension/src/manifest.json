{
  "manifest_version": 3,
  "name": "Setpoint on LinkedIn",
  "version": "0.2.0",
  "description": "Shows beside a LinkedIn job whether Setpoint's Jobs has your application to it.",
  "minimum_chrome_version": "120",
  "permissions": ["storage"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "action": {"default_title": "Setpoint on LinkedIn"},
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
